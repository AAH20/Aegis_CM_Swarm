# Core demo mode
AEGIS_OFFLINE=1

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project
VERTEX_AI_LOCATION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1

# Arena / workers
APP_NAME=target_arena
APP_ENV=demo
ARENA_SEED=42
TARGET_BASE_URL=http://target_arena:8000
AGENT_ROLE=commander
ARSENAL_MODE=safe-demo
MONITOR_TARGET=target_arena
COMMAND_MODE=orchestration
COMMANDER_CPU_ALERT_THRESHOLD=75
COMMANDER_ALERT_PHONE_NUMBER=+15555550100

# ElevenLabs demo
ELEVENLABS_API_KEY=your-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TEXT=Aegis Commander alert. Please review the telemetry.
ELEVENLABS_OUTPUT_PATH=artifacts/elevenlabs_alert.mp3
