{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2z-soc.com/schemas/aegis/security-intent.schema.json",
  "title": "Aegis Security Intent",
  "type": "object",
  "required": ["intent_id", "name", "version", "description", "mitre_techniques", "evidence_requirements", "sequence", "remediation_actions"],
  "properties": {
    "intent_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "mitre_techniques": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["source", "event_type", "required_fields"],
        "properties": {
          "source": {"type": "string"}, "event_type": {"type": "string"},
          "required_fields": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "window_minutes": {"type": "integer", "minimum": 1},
    "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "remediation_actions": {"type": "array", "items": {"type": "string"}},
    "protected_services": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
